<?xml version="1.0" encoding="utf-8"?>
<!--
    قواعد استخراج البيانات لحماية قواعد البيانات والتفضيلات المشفرة عند الاستخراج أو النقل (Data Extraction Security Rules)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

