<!--
    قواعد النسخ الاحتياطي التلقائي لمنع تصدير بيانات المستخدم والملفات المشفرة عبر خدمات النظام العامة
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>


